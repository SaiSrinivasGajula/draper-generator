# Where to store the SQLite db + uploaded images. Point this at a persistent
# volume when deploying (e.g. Railway/Fly.io mounted disk).
DATA_DIR=./data

# Google AI Studio API key for Gemini image generation (nano-banana).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Image generation provider: "gemini" or "openai". Leave blank to auto-detect
# (Gemini is used whenever GEMINI_API_KEY is set; otherwise falls back to OpenAI).
IMAGE_PROVIDER=

# Temporary stand-in for Gemini image generation until Gemini credentials are
# available. Uses OpenAI's gpt-image-1 (multi-image edit) the same way Gemini
# is used above — combines reference + garment photos into one look.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Shared password for the whole team. Leave empty to disable the login gate (local dev).
APP_PASSWORD=
